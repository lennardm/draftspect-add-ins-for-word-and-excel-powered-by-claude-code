# Draftspect — local configuration.
#
# Copy this file to `.env` (same folder) and fill in what you need:
#     copy .env.example .env      (Windows)
#     cp   .env.example .env      (macOS/Linux)
# The daemon reads `.env` on startup. Restart the tray app (or `npm run dev`)
# after changing it. Real shell environment variables, if set, take
# precedence over values here.
#
# EVERY SETTING IS OPTIONAL. With an empty `.env`, Draftspect uses your normal
# Claude Code sign-in and needs nothing here.

# --- OpenRouter routing (optional) ------------------------------------------
# Fill in a key to route the agent through OpenRouter's Anthropic-compatible
# endpoint instead of your Claude Code subscription. Leave blank to use your
# normal Claude Code sign-in. Get a key at https://openrouter.ai/keys
# NOTE: this bills usage to your OpenRouter account, not your Claude plan.
OPENROUTER_API_KEY=

# Optional: pin the exact OpenRouter model used for each speed tier. Only
# applied when OPENROUTER_API_KEY above is set. Uncomment and edit a line if
# the default ever stops resolving (you'll see the active slugs in the daemon
# log line "OpenRouter routing ENABLED").
# OPENROUTER_MODEL_OPUS=anthropic/claude-opus-4.8
# OPENROUTER_MODEL_SONNET=anthropic/claude-sonnet-4.6
# OPENROUTER_MODEL_HAIKU=anthropic/claude-haiku-4.5

# --- Other optional settings ------------------------------------------------
# Default workspace folder (the agent's cwd) if none has been picked yet.
# MATTER_FOLDER=

# Set to 1 for verbose [diag] logging.
# CC_OFFICE_DEBUG=0
